{
  "name": "[USERNAME]/[S_NAME]",
  "description": "[DESCRIPTION]",
  "homepage": "[LINK]",
  "license": "MIT",
  "authors":
  [
    {
      "email": "[EMAIL]",
      "name": "[AUTHOR]"
    }
  ],
  "require":
  {
    "php": ">=5.3.0",
    "vlucas/phpdotenv": "~2.0",
    "rougin/weasley": "~0.6"
  },
  "require-dev":
  {
    "phpunit/phpunit": "*",
    "sanmai/phpunit-legacy-adapter": "*"
  },
  "autoload":
  {
    "psr-4":
    {
      "[NAMESPACE]\\": "src"
    }
  },
  "autoload-dev":
  {
    "psr-4":
    {
      "[NAMESPACE]\\": "tests"
    }
  },
  "scripts":
  {
    "analyze": "phpstan analyse",
    "restyle": "php-cs-fixer fix --config=phpstyle.php",
    "test": "phpunit"
  }
}
