{
  "name": "rougin/basilisk",
  "description": "Simple project skeleton for Slytherin.",
  "keywords": [ "php-app", "php-mvc", "mini-app" ],
  "homepage": "https://roug.in/basilisk/",
  "license": "MIT",
  "authors":
  [
    {
      "email": "rougingutib@gmail.com",
      "homepage": "https://roug.in/",
      "name": "Rougin Gutib",
      "role": "Software Engineer"
    }
  ],
  "require":
  {
    "php": ">=5.3.0",
    "rougin/weasley": "~0.6",
    "vlucas/phpdotenv": "~2.0"
  },
  "require-dev":
  {
    "phpunit/phpunit": "*",
    "sanmai/phpunit-legacy-adapter": "*"
  },
  "autoload":
  {
    "psr-4":
    {
      "App\\": "src"
    }
  },
  "autoload-dev":
  {
    "psr-4":
    {
      "App\\": "tests"
    }
  },
  "scripts":
  {
    "post-root-package-install":
    [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "analyze": "phpstan analyse",
    "restyle": "php-cs-fixer fix --config=phpstyle.php",
    "test": "phpunit"
  }
}