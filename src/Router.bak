<?php

namespace App;

use Rougin\Slytherin\Routing\Router as Slytherin;

/**
 * @package [NAME]
 *
 * @author [AUTHOR] <[EMAIL]>
 */
class Router extends Slytherin
{
    /**
     * @var string
     */
    protected $namespace = '[NAME]\Routes';

    /**
     * @var string
     */
    protected $prefix = '/';

    /**
     * @return \Rougin\Slytherin\Routing\RouteInterface[]
     */
    public function routes()
    {
        $this->get('/', 'Hello@index');

        return $this->routes;
    }
}
